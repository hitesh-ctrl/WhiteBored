# Postgres connection used by Prisma (both processes)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/whiteboard"
# Separate database used only by the test suite
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/whiteboard_test"
# Socket server
SOCKET_PORT=4000
# The single browser origin allowed to connect (never "*")
CORS_ORIGIN="http://localhost:3000"
# Where the browser finds the socket server
NEXT_PUBLIC_SOCKET_URL="http://localhost:4000"
