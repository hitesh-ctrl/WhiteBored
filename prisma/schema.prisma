generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Board {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  /// Separate id for the view-only link, so it does not reveal the edit link.
  viewId    String   @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// SHA-256 hex of the owner key. Null for boards created before owners existed.
  ownerHash String?
  createdAt DateTime @default(now())
  strokes   Stroke[]
  images    BoardImage[]
}

model Stroke {
  seq        Int      @unique @default(autoincrement())
  id         String   @id @db.Uuid
  boardId    String   @db.Uuid
  board      Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  authorId   String   @db.Uuid
  /// SHA-256 hex of the author's secret client key. Null for strokes made without one.
  authorProof String?
  kind       String   @default("pen")
  /// For a fill: the id of the shape it fills, so it moves with that shape. Not a foreign key.
  containerId String? @db.Uuid
  text       String?
  color      String
  width      Int
  points     Json
  pointCount Int
  createdAt  DateTime @default(now())

  @@index([boardId, seq])
}

/// A picture to trace on a board: a built-in outline (template) or an uploaded image (data).
model BoardImage {
  seq         Int      @unique @default(autoincrement())
  id          String   @id @db.Uuid
  boardId     String   @db.Uuid
  board       Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  authorId    String   @db.Uuid
  authorProof String?
  template    String?
  mime        String?
  data        Bytes?
  byteSize    Int      @default(0)
  x           Float
  y           Float
  w           Float
  h           Float
  opacity     Int
  createdAt   DateTime @default(now())

  @@index([boardId, seq])
}
